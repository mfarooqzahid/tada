{
  "manifest_version": 3,
  "name": "Tada",
  "version": "1.0.0",
  "description": "A minimal todo list with an expandable completed history and a Ctrl+N quick list on any page.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tada",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/common.js",
        "src/shared/store.js",
        "src/shared/miniview.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "src/options/options.html",
  "chrome_url_overrides": {
    "newtab": "src/dashboard/dashboard.html"
  },
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open/close the Tada quick list on the current tab"
    },
    "quick-add": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Open Tada on the current tab and start a new task"
    }
  }
}
